# Copy to an operator-controlled file. Do not commit filled secrets.
DATAFORGE_ENV=production
DATAFORGE_ORIGIN=https://dataforge.your-company.example
# Exact address the reverse proxy connects from (127.0.0.1 for host Caddy; the Docker
# bridge gateway, e.g. 172.17.0.1, for the compose template). Never use a wildcard.
DATAFORGE_TRUSTED_PROXIES=127.0.0.1
DATAFORGE_REQUIRE_MFA=true
DATAFORGE_DATA_DIR=/var/lib/dataforge
DATAFORGE_SECRET_KEY_FILE=/etc/dataforge/application.key
DATAFORGE_BACKUP_KEY_FILE=/etc/dataforge/backup.key
DATAFORGE_BACKUP_DIRECTORY=/var/backups/dataforge
DATAFORGE_BACKUP_INTERVAL_SECONDS=86400
DATAFORGE_BACKUP_RETENTION_DAYS=30
DATAFORGE_RESULT_RETENTION_DAYS=90
DATAFORGE_QUALIFICATION_FILE=/etc/dataforge/qualification.json
# Enable one tested alert destination before the production preflight can pass.
DATAFORGE_ALERT_EMAILS=operations@your-company.example
DATAFORGE_SMTP_HOST=smtp.your-company.example
DATAFORGE_SMTP_MODE=starttls
DATAFORGE_SMTP_PORT=587
DATAFORGE_SMTP_FROM=dataforge@your-company.example
DATAFORGE_SMTP_USERNAME=
DATAFORGE_SMTP_PASSWORD=
# DATAFORGE_ALERT_WEBHOOK=https://alerts.your-company.example/dataforge
# DATAFORGE_ALERT_WEBHOOK_TOKEN=
# DATAFORGE_OIDC_ISSUER=https://login.your-company.example/exact-issuer
# DATAFORGE_OIDC_CLIENT_ID=
# DATAFORGE_OIDC_CLIENT_SECRET=
# DATAFORGE_OIDC_ALLOWED_HOSTS=additional-explicit-provider-host.example
# DATAFORGE_OIDC_REQUIRED_ACR=
# DATAFORGE_BACKUP_S3_BUCKET=
# DATAFORGE_BACKUP_S3_PREFIX=dataforge
# DATAFORGE_BACKUP_KMS_KEY=
# AWS_DEFAULT_REGION=
# Prefer the host's instance role; never put cloud access keys in the source tree.
