{
  "version": "1.0",
  "mapping": {
    "id": "m_sample_customers_cleanse",
    "name": "Customer cleanse (CSV to CSV)",
    "description": "Standardises names, emails, phone numbers and country codes from customers.csv, rejects rows that fail data-quality rules (flags, but keeps, countries outside the supported list), keeps active customers and writes customers_clean.csv and customers_rejects.csv.",
    "createdAt": "2025-11-30T00:00:00.000Z",
    "updatedAt": "2025-11-30T00:00:00.000Z"
  },
  "nodes": [
    {
      "id": "n1",
      "type": "csv_source",
      "name": "SRC_customers",
      "position": {
        "x": 40,
        "y": 160
      },
      "config": {
        "fileName": "customers.csv",
        "delimiter": ",",
        "header": true,
        "sampleSize": 20480,
        "rememberFile": true
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n2",
      "type": "expression",
      "name": "EXP_standardize",
      "position": {
        "x": 300,
        "y": 160
      },
      "config": {
        "exclude": [],
        "fields": [
          {
            "name": "customer_id",
            "expression": "TRIM(customer_id)",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "first_name",
            "expression": "UPPER(SUBSTR(TRIM(first_name), 1, 1)) || LOWER(SUBSTR(TRIM(first_name), 2))",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "last_name",
            "expression": "UPPER(SUBSTR(TRIM(last_name), 1, 1)) || LOWER(SUBSTR(TRIM(last_name), 2))",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "email",
            "expression": "LOWER(TRIM(email))",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "phone",
            "expression": "REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(TRIM(phone), ' ', ''), '-', ''), '(', ''), ')', ''), '.', '')",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "country",
            "expression": "UPPER(TRIM(country))",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "signup_date",
            "expression": "CAST(signup_date AS DATE)",
            "type": "DATE",
            "setVariable": ""
          },
          {
            "name": "status",
            "expression": "UPPER(TRIM(status))",
            "type": "VARCHAR",
            "setVariable": ""
          }
        ]
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n3",
      "type": "data_quality",
      "name": "DQ_customer_checks",
      "position": {
        "x": 580,
        "y": 160
      },
      "config": {
        "threshold": "",
        "rules": [
          {
            "name": "Customer ID required",
            "column": "customer_id",
            "type": "not_null",
            "params": {},
            "severity": "error",
            "action": "reject"
          },
          {
            "name": "Email required",
            "column": "email",
            "type": "not_null",
            "params": {},
            "severity": "error",
            "action": "reject"
          },
          {
            "name": "Valid email",
            "column": "email",
            "type": "regex",
            "params": {
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            },
            "severity": "error",
            "action": "reject"
          },
          {
            "name": "Known country",
            "column": "country",
            "type": "allowed",
            "params": {
              "values": "IN,US,GB,SG,DE,IE"
            },
            "severity": "warning",
            "action": "flag"
          }
        ]
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n4",
      "type": "filter",
      "name": "FIL_active",
      "position": {
        "x": 860,
        "y": 110
      },
      "config": {
        "condition": "status = 'ACTIVE'"
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n5",
      "type": "expression",
      "name": "EXP_derive",
      "position": {
        "x": 1120,
        "y": 110
      },
      "config": {
        "exclude": [
          "status"
        ],
        "fields": [
          {
            "name": "full_name",
            "expression": "first_name || ' ' || last_name",
            "type": "VARCHAR",
            "setVariable": ""
          },
          {
            "name": "signup_month",
            "expression": "strftime(signup_date, '%Y-%m')",
            "type": "VARCHAR",
            "setVariable": ""
          }
        ]
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n6",
      "type": "sorter",
      "name": "SRT_customer_id",
      "position": {
        "x": 1380,
        "y": 110
      },
      "config": {
        "keys": [
          {
            "column": "customer_id",
            "direction": "ASC"
          }
        ],
        "distinct": false
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n7",
      "type": "csv_target",
      "name": "TGT_customers_clean",
      "position": {
        "x": 1640,
        "y": 50
      },
      "config": {
        "fileName": "customers_clean.csv",
        "delimiter": ",",
        "header": true
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n8",
      "type": "preview_target",
      "name": "PREVIEW_customers",
      "position": {
        "x": 1640,
        "y": 210
      },
      "config": {
        "limit": 1000
      },
      "ports": {
        "in": [],
        "out": []
      }
    },
    {
      "id": "n9",
      "type": "reject_target",
      "name": "REJECT_customer_quality",
      "position": {
        "x": 860,
        "y": 380
      },
      "config": {
        "fileName": "customers_rejects.csv",
        "delimiter": ",",
        "header": true
      },
      "ports": {
        "in": [],
        "out": []
      }
    }
  ],
  "links": [
    {
      "id": "l1",
      "from": "n1",
      "to": "n2"
    },
    {
      "id": "l2",
      "from": "n2",
